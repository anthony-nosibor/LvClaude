{
  "expo": {
    "name": "NohaTransport",
    "slug": "noha-transport-lettre-de-voiture",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lettredevoiture",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nohatransport.lettredevoiture",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "NohaTransport utilise la caméra pour joindre une photo de la marchandise à la lettre de voiture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "INTERNET"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.nohatransport.lettredevoiture"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
